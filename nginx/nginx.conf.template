worker_processes auto;

events {
    worker_connections 1024;
}

http {
    # --- 1. DYNAMIC RATE LIMITING ZONES ---
    # Values injected securely at runtime via envsubst
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=${NGINX_API_RATE};
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=${NGINX_AUTH_RATE};
    limit_req_zone $binary_remote_addr zone=hangfire_limit:10m rate=${NGINX_HANGFIRE_RATE};

    server_tokens off;

    upstream api_backend {
        server api:8080;
    }

    # --- 2. WEBSOCKET MAPPING ---
    # Automatically resolves the correct Connection header based on the incoming request type
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        # Azure App Service routes external traffic to the container on port 80.
        listen 80;
        
        # --- 3. GLOBAL PROXY HEADERS (DRY Principle) ---
        # These headers are inherited by all location blocks below unless overridden
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # --- 4. GLOBAL API PROXYING (REST & SIGNALR) ---
        location / {
            limit_req zone=api_limit burst=${NGINX_API_BURST} nodelay;
            
            proxy_pass http://api_backend;
            
            # Dynamically sets Connection header for HTTP and WebSocket requests
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        # --- 5. TIGHTENED SECURITY FOR IDENTITY ENDPOINTS ---
        
        # Standard API Authentication
        location /api/auth/ {
            limit_req zone=auth_limit burst=${NGINX_AUTH_BURST} nodelay;
            proxy_pass http://api_backend;
        }

        # Infrastructure Ops (Dashboard) Authentication
        location /api/ops/auth/ {
            limit_req zone=auth_limit burst=${NGINX_AUTH_BURST} nodelay;
            proxy_pass http://api_backend;
        }

        # --- 6. HANGFIRE DASHBOARD SECURITY (EDGE BOUNDARY) ---
        
        # Canonicalize /hangfire -> /hangfire/ to keep dashboard URLs consistent.
        location = /hangfire { 
            return 301 /hangfire/; 
        }

        # Strict prefix match (^~) prevents accidental matches like /hangfire-fake
        location ^~ /hangfire/ {
            # Traffic shaping for polling (no 'nodelay')
            limit_req zone=hangfire_limit burst=${NGINX_HANGFIRE_BURST};
            
            # STRICT NETWORK BOUNDARY
            allow 172.21.0.0/16;    # Allow Docker bridge network (local/internal)
            # allow 203.0.113.50;   # Allow corporate VPN
            deny all;

            proxy_pass http://api_backend;
            
            # Hangfire dashboard also uses WebSockets for live metrics updates
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}