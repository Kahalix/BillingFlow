# File: .env.example
# ==============================================================================
# BillingFlow Environment Variables Template
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env`
# 2. Replace the placeholder values with your actual local/test credentials.
# 3. NEVER commit the `.env` file to version control.
# ==============================================================================

# Application Environment
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Database
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE
DB_NAME=BillingFlowDb

# Redis (SignalR Backplane for scalable WebSockets & Cache)
REDIS_CONNECTION=redis:6379,abortConnect=false

# Authentication (JWT)
# Use a strong random string (at least 64 characters) for local development
JWT_SECRET=your_super_secret_jwt_key_that_must_be_at_least_64_characters_long
JWT_ISSUER=BillingFlow
JWT_AUDIENCE=BillingFlowUsers
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# Stripe Integration
# Get these from your Stripe Developer Dashboard -> API Keys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
# Run `stripe listen` in the Stripe CLI to get your local webhook secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# ==============================================================================
# RATE LIMITING
# Defines limits to protect against brute-force, DDoS, and SMTP spam.
# ==============================================================================

# .NET Internal Limits (Application Layer - evaluated per user ID or IP)
# Global limit for standard API endpoints
RATE_LIMIT_GLOBAL_PERMIT_LIMIT=100
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1

# Auth policies (evaluated strictly by IP to protect cloud infrastructure)
RATE_LIMIT_LOGIN_PERMIT_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=1

RATE_LIMIT_DASHBOARD_LOGIN_PERMIT_LIMIT=3
RATE_LIMIT_DASHBOARD_LOGIN_WINDOW_MINUTES=1

RATE_LIMIT_PASSWORD_RESET_PERMIT_LIMIT=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES=15

RATE_LIMIT_EMAIL_VERIFICATION_PERMIT_LIMIT=5
RATE_LIMIT_EMAIL_VERIFICATION_WINDOW_MINUTES=15

# NGINX Edge Limits (Gateway Layer)
# Global API throttle (e.g., 10 requests per second per IP) and queue burst size
NGINX_API_RATE=10r/s
NGINX_API_BURST=20

# Stricter identity throttle
NGINX_AUTH_RATE=2r/s
NGINX_AUTH_BURST=5

# Dedicated limits for Hangfire Dashboard (higher burst for background polling)
NGINX_HANGFIRE_RATE=20r/s
NGINX_HANGFIRE_BURST=20

# ==============================================================================
# OBSERVABILITY
# ==============================================================================
# Password for the local Grafana UI dashboard (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=YOUR_STRONG_GRAFANA_PASSWORD

# ==============================================================================
# IDENTITY & SESSION POLICIES (Format: d.hh:mm:ss)
# ==============================================================================
# In-memory validation cache TTL (balances DB load against instant revocation)
SESSION_CACHE_VALIDATION_TTL=00:05:00

# Session Lifetime (Sliding Expiration - idle timeout)
IDENTITY_SESSION_LIFETIME=7.00:00:00

# Absolute Session Hard Cap (Max time before forcing re-login regardless of activity)
IDENTITY_ABSOLUTE_SESSION_LIFETIME=30.00:00:00

# Refresh Token rotation lifetime
IDENTITY_REFRESH_TOKEN_LIFETIME=7.00:00:00

# One-time tokens expiration limits
IDENTITY_PASSWORD_RESET_LIFETIME=01:00:00
IDENTITY_EMAIL_CONFIRMATION_LIFETIME=1.00:00:00